# Bot User OAuth Token — Slack app settings → OAuth & Permissions.
# Starts with xoxb-
SLACK_BOT_TOKEN=xoxb-

# App-Level Token with the connections:write scope — Basic Information →
# App-Level Tokens. Only needed in Socket Mode, which is the default.
# Starts with xapp-
SLACK_APP_TOKEN=xapp-

# Only needed if you set SLACK_MODE=http. Basic Information → Signing Secret.
# SLACK_SIGNING_SECRET=

# socket (default) or http
# SLACK_MODE=socket
# PORT=3000
# LOG_LEVEL=debug
