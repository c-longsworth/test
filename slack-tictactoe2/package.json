{
  "name": "slack-tictactoe2",
  "version": "1.0.0",
  "private": true,
  "description": "Tic Tac Toe\u00b2 \u2014 ultimate tic tac toe, played in Slack",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
